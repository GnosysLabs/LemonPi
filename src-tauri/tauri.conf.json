{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LemonPi",
  "version": "0.1.1",
  "identifier": "app.lemonpi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/lemonpi-narration/": "lemonpi-narration/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A native desktop workspace for Pi",
    "longDescription": "LemonPi is a cross-platform graphical workspace for the Pi coding agent.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQkY4RkUyN0VBMTYzNzkKUldSNVk2Ris0bysvR21oNUVpTUxNbjJ1V1B0UWRwZ0lSbkJOZXVvOFNGdnZSaU5MOTVmQ0lnWncK",
      "endpoints": [
        "https://github.com/GnosysLabs/LemonPi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
